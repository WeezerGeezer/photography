# Cloudflare Pages Headers Configuration
# Optimizes caching and compression for photography portfolio

# Images - Long-term caching (1 year) since filenames include content hashes
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JavaScript - Long-term caching with immutable
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts - Long-term caching
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Data files - Short cache with revalidation (5 minutes)
# Albums.json is fetched from R2, but this applies to any local data
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# HTML pages - Short cache with revalidation (1 hour)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Root index
/
  Cache-Control: public, max-age=3600, must-revalidate

# Enable compression for text-based assets (handled by Cloudflare)
# Cloudflare automatically compresses, but this ensures proper content types
/assets/css/*
  Content-Type: text/css; charset=utf-8

/assets/js/*
  Content-Type: application/javascript; charset=utf-8

/*.html
  Content-Type: text/html; charset=utf-8
