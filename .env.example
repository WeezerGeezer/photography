# Admin Panel Environment Variables
# Copy this file to .env.local for local development
# Set these in Cloudflare Dashboard > Pages > Settings > Environment Variables for production

# Admin password for logging into the admin panel
ADMIN_PASSWORD=your-secure-password-here

# Secret key for token generation (use a random string)
ADMIN_SECRET=generate-a-random-32-character-string

# R2 Bucket name (must match the bucket created in Cloudflare dashboard)
R2_BUCKET_NAME=photography-portfolio
